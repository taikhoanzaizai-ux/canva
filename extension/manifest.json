{
  "manifest_version": 3,
  "name": "SKST Canva Studio — Kết nối dựng video",
  "version": "0.14.11",
  "description": "Dựng cảnh từ ứng dụng SKST trong thiết kế Canva do bạn chọn. Chỉ làm việc trên Canva và máy của bạn.",
  "permissions": ["storage", "scripting"],
  "optional_permissions": ["downloads"],
  "host_permissions": ["http://127.0.0.1:8766/*", "https://www.canva.com/design/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "SKST Canva Studio"},
  "content_scripts": [{"matches": ["https://www.canva.com/design/*/edit*"], "js": ["adapter.js", "content.js"], "run_at": "document_idle"}]
}
